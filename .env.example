# --- Core ---
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/lexium
API_PORT=4000
HTTPS_PORT=8443
SITE_URL=https://lexium.local:8443
TLS_KEY=certs/localhost-key.pem
TLS_CERT=certs/localhost.pem
JWT_SECRET=change-me-to-a-long-random-string

# --- Seeded admin (printed once by `npm run seed`) ---
ADMIN_NAME="Lexium Admin"
ADMIN_EMAIL=admin@lexium.local
ADMIN_PASSWORD=change-me-now

# --- Mail (Mailpit locally) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM="Lexium Consulting <no-reply@lexiumconsulting.com>"
MAILPIT_API=http://127.0.0.1:8025

# --- Lead routing owners (§8.4) ---
LEAD_REGULATORY=regulatory.lead@lexium.local
LEAD_MANUFACTURING=plant.setup.lead@lexium.local
LEAD_MARKET_ENTRY=strategy.markets.lead@lexium.local
LEAD_MA=transaction.lead@lexium.local
LEAD_CAPITAL=capital.advisory.lead@lexium.local
LEAD_GENERAL=business.development@lexium.local

# --- Stock images (optional; free keys) ---
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Show items awaiting approval (status "review") on the local site with a preview ribbon. Set false for launch.
CONTENT_PREVIEW=true
